<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      이 파일은 인터넷 권한을 선언하지 않는다. 게임 파일이 전부 APK 안에 있고
      WebViewAssetLoader가 그것을 로컬에서 서빙하기 때문이다.
      다만 병합된 앱에는 INTERNET · ACCESS_NETWORK_STATE 가 있다 — Play 결제 라이브러리(6 이상)가 딸고 오는
      Google 로그 전송 부품(datatransport)이 넣는다. 라이브러리의 작동 기록을 Google 에 보내는 용도다.
      CI 가 그 출처까지 확인한다(다른 곳에서 INTERNET 이 오면 빨개진다).

      진동은 권한이 필요하다 — WebView 의 navigator.vibrate() 는 앱에 VIBRATE 가 없으면 logcat 에 경고만 남기고
      조용히 아무것도 안 한다. 그래서 설정의 '진동'이 APK 에서는 울릴 수 없었다(W 에서 찾았다).
      일반(install-time) 권한이라 사용자에게 묻지 않고, 데이터 수집과도 무관하다.
      이 목록 밖의 권한이 병합 매니페스트에 끼어들면 CI(tools/check-permissions.mjs)가 빨개진다.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Catpaw">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Catpaw"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
