<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ 용. backup_rules.xml 과 같은 규칙 — localStorage 는 두고 서비스 워커 캐시만 뺀다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="app_webview/Default/Service Worker" />
        <exclude domain="file" path="app_webview/Default/Cache" />
        <exclude domain="file" path="app_webview/Default/Code Cache" />
        <exclude domain="file" path="app_webview/Default/GPUCache" />
        <exclude domain="file" path="app_webview/Service Worker" />
        <exclude domain="file" path="app_webview/Cache" />
        <exclude domain="file" path="app_webview/Code Cache" />
        <exclude domain="file" path="app_webview/GPUCache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app_webview/Default/Service Worker" />
        <exclude domain="file" path="app_webview/Default/Cache" />
        <exclude domain="file" path="app_webview/Default/Code Cache" />
        <exclude domain="file" path="app_webview/Default/GPUCache" />
        <exclude domain="file" path="app_webview/Service Worker" />
        <exclude domain="file" path="app_webview/Cache" />
        <exclude domain="file" path="app_webview/Code Cache" />
        <exclude domain="file" path="app_webview/GPUCache" />
    </device-transfer>
</data-extraction-rules>
